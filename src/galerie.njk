---
layout: base.njk
active: galerie
permalink: /galerie.html
title_tag: "Galerie photos — Aïkido à Vescovato | Kanjo Isulanu"
description: "Découvrez en images la pratique de l'Aïkido au dojo Kanjo Aïkido Isulanu à Vescovato (Haute-Corse) : tatamis, armes et stages, saison par saison."
---
{% set p = pages.galerie %}
<!-- ===== HEADER ===== -->
<section class="section section--tight">
  <div class="section__inner" style="text-align:center;">
    <div class="eyebrow">{{ p.eyebrow }}</div>
    <h1 class="hero__title" style="font-size:clamp(34px,5vw,58px);">{{ p.title }}</h1>
    <p class="section-lead" style="max-width:620px; margin:0 auto;">{{ p.lead }}</p>
  </div>
</section>

<!-- ===== MOSAÏQUE PAR SAISON ===== -->
<section class="section" style="padding-top:20px;">
  <div class="section__inner" style="padding-top:30px;">
    {%- set hasPhotos = false %}
    {%- for season in galerie.seasons %}
      {%- if season.photos and season.photos.length %}{% set hasPhotos = true %}{% endif %}
    {%- endfor %}

    {%- if galerie.seasons and galerie.seasons.length %}
      {%- for season in galerie.seasons %}
      <div class="gallery-season">
        <h2 class="gallery-season__title">{{ season.title }}</h2>
        {%- if season.photos and season.photos.length %}
          <div class="carousel" data-carousel>
            <button type="button" class="carousel__btn carousel__btn--prev" aria-label="Photo précédente">‹</button>
            <div class="carousel__track">
              {%- for photo in season.photos %}
              <figure class="carousel__slide">
                <img loading="lazy" src="{{ photo.image }}" alt="{{ photo.alt }}">
                {%- if photo.alt %}<figcaption class="carousel__caption">{{ photo.alt }}</figcaption>{% endif %}
              </figure>
              {%- endfor %}
            </div>
            <button type="button" class="carousel__btn carousel__btn--next" aria-label="Photo suivante">›</button>
            <div class="carousel__dots" aria-hidden="true"></div>
          </div>
        {%- else %}
          <div class="carousel__track">
            {%- for i in range(0, 3) %}
            <figure class="carousel__slide placeholder-media" style="min-height:320px;">[ photo ]</figure>
            {%- endfor %}
          </div>
        {%- endif %}
      </div>
      {%- endfor %}
    {%- else %}
      <div class="carousel__track">
        {%- for i in range(0, 3) %}
        <figure class="carousel__slide placeholder-media" style="min-height:320px;">[ photo ]</figure>
        {%- endfor %}
      </div>
    {%- endif %}

    {%- if not hasPhotos %}
    <p class="note-italic">{{ p.note }}</p>
    {%- endif %}
  </div>
</section>
<script>
(function () {
  document.querySelectorAll("[data-carousel]").forEach(function (car) {
    var track = car.querySelector(".carousel__track");
    var prev = car.querySelector(".carousel__btn--prev");
    var next = car.querySelector(".carousel__btn--next");
    var dotsWrap = car.querySelector(".carousel__dots");
    var slides = track ? track.querySelectorAll(".carousel__slide") : [];
    if (!track || slides.length === 0) return;
    var count = slides.length;
    var index = 0;
    var timer = null;

    // Une seule photo : pas de flèches, points, ni autoplay
    if (count < 2) {
      if (prev) prev.style.display = "none";
      if (next) next.style.display = "none";
      return;
    }

    // Points indicateurs
    var dots = [];
    for (var i = 0; i < count; i++) {
      var d = document.createElement("button");
      d.className = "carousel__dot";
      d.type = "button";
      d.setAttribute("aria-label", "Aller à la photo " + (i + 1));
      (function (n) { d.addEventListener("click", function () { goTo(n, true); }); })(i);
      dotsWrap.appendChild(d);
      dots.push(d);
    }

    function goTo(n, user) {
      index = (n + count) % count;
      track.scrollTo({ left: track.clientWidth * index, behavior: "smooth" });
      dots.forEach(function (dot, j) { dot.classList.toggle("is-active", j === index); });
      if (user) restart();
    }

    prev.addEventListener("click", function () { goTo(index - 1, true); });
    next.addEventListener("click", function () { goTo(index + 1, true); });

    // Synchronise l'index si l'utilisateur fait glisser au doigt
    var scrollTO;
    track.addEventListener("scroll", function () {
      clearTimeout(scrollTO);
      scrollTO = setTimeout(function () {
        var n = Math.round(track.scrollLeft / track.clientWidth);
        if (n !== index) { index = n; dots.forEach(function (dot, j) { dot.classList.toggle("is-active", j === index); }); }
      }, 120);
    }, { passive: true });

    // Défilement automatique
    function start() { timer = setInterval(function () { goTo(index + 1); }, 5000); }
    function stop() { clearInterval(timer); }
    function restart() { stop(); start(); }
    car.addEventListener("mouseenter", stop);
    car.addEventListener("mouseleave", start);

    dots[0].classList.add("is-active");
    window.addEventListener("resize", function () { track.scrollLeft = track.clientWidth * index; });
    start();
  });
})();
</script>
