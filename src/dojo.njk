</script>

<!-- ===== CTA ===== -->
<section class="cta-band">
  <div class="section__inner">
    <h2 class="cta-band__title">Prêt à nous rejoindre ?</h2>
    <a class="btn-gold" href="{{ site.helloasso or '/contact.html' }}"{% if site.helloasso %} target="_blank" rel="noopener"{% endif %}>S'INSCRIRE EN LIGNE</a>
  </div>
</section>
