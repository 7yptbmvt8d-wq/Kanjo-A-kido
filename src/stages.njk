---
layout: base.njk
active: stages
permalink: /stages.html
title_tag: "Stages d'Aïkido en Corse — Calendrier | Kanjo Isulanu"
description: "Découvrez le calendrier des stages d'Aïkido de la saison à Vescovato et en Corse, avec les dojos partenaires. Rejoignez-nous sur le tatami."
---
{% set p = pages.stages %}
<!-- ===== HEADER ===== -->
<section class="section section--tight">
  <div class="section__inner" style="text-align:center;">
    <div class="eyebrow">{{ p.eyebrow }}</div>
    <h1 class="hero__title" style="font-size:clamp(32px,5vw,54px);">{{ p.title }}</h1>
    <p class="section-lead" style="max-width:600px; margin:0 auto;">{{ p.lead }}</p>
  </div>
</section>

<!-- ===== CALENDRIER (FRISE VERTICALE) ===== -->
<section class="section" style="padding-bottom:50px;">
  <div class="section__inner" style="padding-top:30px;">
    <div class="stage-rail">
      <div class="stage-rail__line"></div>
      {%- for s in p.stages %}
      {%- if s.type == "end" %}
      <div class="stage-item stage-item--end">
        <div class="stage-item__date">{{ s.date }}</div>
        <div class="stage-item__node"></div>
        <div class="stage-item__closing">{{ s.title }}</div>
      </div>
      {%- else %}
      <div class="stage-item">
        <div class="stage-item__date">{{ s.date }}</div>
        <div class="stage-item__node"></div>
        <div class="stage-item__card{{ ' stage-item__card--featured' if s.type == 'featured' }}">
          <div class="stage-item__title">{{ s.title }}</div>
          {%- if s.dates %}
          <div class="stage-item__dates">{{ s.dates }}</div>
          {%- endif %}
          {%- if s.desc %}
          <div class="stage-item__desc">{{ s.desc | safe }}</div>
          {%- endif %}
          {%- if s.meta %}
          <div class="stage-item__meta">{{ s.meta }}</div>
          {%- endif %}
          {%- if s.poster %}
          <a href="{{ s.link or s.poster }}" target="_blank" rel="noopener">
            <img loading="lazy" class="stage-item__poster" src="{{ s.poster }}" alt="Affiche — {{ s.title }}">
          </a>
          {%- endif %}
          {%- if s.link %}
          <a class="stage-item__btn" href="{{ s.link }}" target="_blank" rel="noopener">S'inscrire</a>
          {%- endif %}
        </div>
      </div>
      {%- endif %}
      {%- endfor %}
    </div>

    <div class="stage-rail__foot">
      <div class="note-italic" style="margin:0;">{{ p.note }}</div>
      <a class="btn-outline" href="https://stages-aikido.fr/" target="_blank" rel="noopener">STAGES PARTOUT EN FRANCE</a>
    </div>
  </div>
</section>
