---
layout: base.njk
active: accueil
permalink: /index.html
title_tag: "Kanjo Aïkido Isulanu — Cours d'Aïkido à Vescovato (Haute-Corse)"
description: "Dojo d'Aïkido à Vescovato (Haute-Corse), ouvert à toutes et à tous, sans compétition. Découvrez l'esprit Kanjo et venez essayer gratuitement."
---
{% set p = pages.accueil %}
<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero__frame"></div>
  <div class="hero__inner">
    {% if site.logo %}
    <img src="{{ site.logo }}" alt="Kanjo Aïkido Isulanu" style="height:250px; width:auto; margin:0 auto 30px; display:block;">
    {% else %}
    <img class="hero__logo" src="/assets/kanji-kanjo.svg" alt="Kanjo">
    {% endif %}
    <div class="hero__eyebrow">{{ p.heroEyebrow }}</div>
    <h1 class="hero__title">{{ p.heroTitle }}</h1>
    <p class="hero__lead">{{ p.heroLead }}</p>
    <div class="hero__actions">
      <a class="btn-gold" href="/contact.html">2 COURS D’ESSAI</a>
      <a class="btn-outline" href="/dojo.html">DÉCOUVRIR LE DOJO</a>
    </div>
  </div>
</section>

<!-- ===== ESPRIT KANJO ===== -->
<section class="section section--alt">
  <div class="kanji-watermark" style="font-size:210px; left:-30px; top:40px;">感</div>
  <div class="kanji-watermark" style="font-size:210px; right:-30px; bottom:20px;">情</div>
  <div class="section__inner">
    <div class="section-head">
      <div class="eyebrow">{{ p.espritEyebrow }}</div>
      <h2 class="section-title">{{ p.espritTitle }}</h2>
      <p class="section-lead">{{ p.espritLead }}</p>
    </div>
    <div class="kanji-pair">
      <div class="kanji-block">
        <div class="kanji-block__char">感</div>
        <div class="kanji-block__romaji">KAN</div>
        <div class="kanji-block__label">{{ p.kanLabel }}</div>
        <p class="kanji-block__desc">{{ p.kanDesc }}</p>
      </div>
      <div class="kanji-block">
        <div class="kanji-block__char">情</div>
        <div class="kanji-block__romaji">JO</div>
        <div class="kanji-block__label">{{ p.joLabel }}</div>
        <p class="kanji-block__desc">{{ p.joDesc }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== CITATION ===== -->
<section class="section">
  <div class="section__inner">
    <div class="quote">
      <p class="quote__text">{{ p.quote }}</p>
      <div class="quote__cite">— L'ESPRIT DU DOJO</div>
    </div>
  </div>
</section>

<!-- ===== UNE VOIE POUR CHACUN ===== -->
<section class="section">
  <div class="section__inner">
    <div class="section-head">
      <div class="eyebrow">{{ p.voieEyebrow }}</div>
      <h2 class="section-title">{{ p.voieTitle }}</h2>
    </div>
    <div class="prose" style="max-width:760px; margin:0 auto; text-align:left;">
      {%- for para in p.voieParas %}
      <p>{{ para | safe }}</p>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ===== EXPLORATION ===== -->
<section class="section section--alt section--divider">
  <div class="section__inner">
    <div class="section-head">
      <div class="eyebrow">道 — EXPLORER</div>
      <h2 class="section-title">Entrer dans la voie</h2>
    </div>
    <div class="cards">
      <a class="card" href="/histoire.html">
        <div class="card__kanji">合気道</div>
        <h3 class="card__title">L'histoire</h3>
        <p class="card__desc">D'O-Senseï Morihei Ueshiba à la lignée Tamura : aux sources de l'Aïkido.</p>
        <span class="card__more">DÉCOUVRIR →</span>
      </a>
      <a class="card" href="/dojo.html">
        <div class="card__kanji">道場</div>
        <h3 class="card__title">Le dojo</h3>
        <p class="card__desc">La pratique, les horaires, l'adresse et les formules d'adhésion.</p>
        <span class="card__more">DÉCOUVRIR →</span>
      </a>
      <a class="card" href="/enseignant.html">
        <div class="card__kanji">先生</div>
        <h3 class="card__title">Les enseignants</h3>
        <p class="card__desc">Deux parcours, une transmission, une exigence au service de l'élève.</p>
        <span class="card__more">DÉCOUVRIR →</span>
      </a>
    </div>
  </div>
</section>

{% if p.testimonials and p.testimonials.length %}
<!-- ===== TÉMOIGNAGES ===== -->
<section class="section">
  <div class="section__inner">
    <div class="section-head">
      <div class="eyebrow">{{ p.testiEyebrow }}</div>
      <h2 class="section-title">{{ p.testiTitle }}</h2>
    </div>
    <div class="testi-grid">
      {%- for t in p.testimonials %}
      <figure class="testi">
        <div class="testi__mark">”</div>
        {%- if t.rating %}
        <div class="testi__stars" aria-label="Note : {{ t.rating }} sur 5">
          {%- for i in range(1, 6) %}<span class="{{ 'is-on' if i <= t.rating }}">★</span>{% endfor %}
        </div>
        {%- endif %}
        <blockquote class="testi__quote">{{ t.quote }}</blockquote>
        <figcaption class="testi__cite">
          <span class="testi__name">{{ t.name }}</span>
          {%- if t.meta %}<span class="testi__meta">{{ t.meta }}</span>{% endif %}
        </figcaption>
      </figure>
      {%- endfor %}
    </div>
    {%- if site.reviewUrl %}
    <div style="text-align:center; margin-top:44px;">
      <a class="btn-outline" href="{{ site.reviewUrl }}" target="_blank" rel="noopener">LAISSER UN AVIS</a>
    </div>
    {%- endif %}
  </div>
</section>
{% endif %}

<!-- ===== AVIS GOOGLE (automatiques) ===== -->
<section class="section section--alt section--divider" id="google-reviews" hidden>
  <div class="section__inner">
    <div class="section-head">
      <div class="eyebrow">★ — AVIS GOOGLE</div>
      <h2 class="section-title">Ils pratiquent avec nous</h2>
      <p class="section-lead" id="gr-summary"></p>
    </div>
    <div class="testi-grid" id="gr-grid"></div>
    {%- if site.reviewUrl %}
    <div style="text-align:center; margin-top:44px;">
      <a class="btn-outline" href="{{ site.reviewUrl }}" target="_blank" rel="noopener">LAISSER UN AVIS SUR GOOGLE</a>
    </div>
    {%- endif %}
  </div>
</section>
<script>
(function () {
  function stars(n) {
    var s = "";
    for (var i = 1; i <= 5; i++) s += '<span class="' + (i <= n ? "is-on" : "") + '">★</span>';
    return '<div class="testi__stars">' + s + "</div>";
  }
  fetch("/.netlify/functions/reviews", { cache: "no-store" })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (!d || !d.reviews || !d.reviews.length) return;
      var grid = document.getElementById("gr-grid");
      d.reviews.forEach(function (rv) {
        var fig = document.createElement("figure");
        fig.className = "testi";
        var mark = document.createElement("div");
        mark.className = "testi__mark"; mark.textContent = "”";
        var st = document.createElement("div"); st.innerHTML = stars(rv.rating || 5);
        var q = document.createElement("blockquote");
        q.className = "testi__quote"; q.textContent = rv.text;
        var cite = document.createElement("figcaption");
        cite.className = "testi__cite";
        var nm = document.createElement("span");
        nm.className = "testi__name"; nm.textContent = rv.author || "Client";
        cite.appendChild(nm);
        if (rv.time) {
          var mt = document.createElement("span");
          mt.className = "testi__meta"; mt.textContent = rv.time;
          cite.appendChild(mt);
        }
        fig.appendChild(mark);
        fig.appendChild(st.firstChild);
        fig.appendChild(q);
        fig.appendChild(cite);
        grid.appendChild(fig);
      });
      if (d.rating) {
        document.getElementById("gr-summary").textContent =
          "Note moyenne de " + d.rating.toFixed(1) + " / 5 sur " + d.total + " avis Google.";
      }
      document.getElementById("google-reviews").hidden = false;
    })
    .catch(function () {});
})();
</script>

{% if site.appUrl %}
<!-- ===== APPLICATION DU DOJO ===== -->
<section class="section section--alt section--divider">
  <div class="section__inner">
    <div class="app-band">
      <div class="app-band__text">
        <div class="eyebrow">アプリ — L'APPLICATION</div>
        <h2 class="section-title" style="text-align:left;">L'appli du dojo, dans ta poche</h2>
        <p class="section-lead" style="text-align:left; margin:0;">Horaires, actualités et infos du dojo à portée de main. Installe l'application Kanjo Aïkido Isulanu sur ton téléphone en un geste — aucun store requis.</p>
        <a class="btn-gold" style="margin-top:26px;" href="{{ site.appUrl }}" target="_blank" rel="noopener">🥋&nbsp;&nbsp;INSTALLER L'APPLICATION</a>
      </div>
      <div class="app-band__badge" aria-hidden="true">
        <div class="app-band__phone">
          <span class="app-band__kanji">寅枢</span>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}
